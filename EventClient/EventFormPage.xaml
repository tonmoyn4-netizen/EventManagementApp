<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventClient.EventFormPage"
             Title="Event">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Image x:Name="Photo" WidthRequest="120" HeightRequest="120" Aspect="AspectFill" />
            <Button Text="Choose Image" Clicked="OnChooseImageClicked" />
            <Entry Placeholder="Title" Text="{Binding Event.Title}" />
            <Label Text="Event date" />
            <DatePicker Date="{Binding Event.EventDate}" />
            <HorizontalStackLayout Spacing="10">
                <Label Text="Is active" VerticalOptions="Center" />
                <Switch IsToggled="{Binding Event.IsActive}" />
            </HorizontalStackLayout>
            <!-- detail data: one editable row per attendee -->
            <Label Text="Attendees" FontAttributes="Bold" Margin="0,10,0,0" />
            <VerticalStackLayout Spacing="5" BindableLayout.ItemsSource="{Binding Attendees}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="5">
                            <Entry Placeholder="Name" Text="{Binding Name}" />
                            <Entry Grid.Column="1" Placeholder="Email" Text="{Binding Email}" />
                            <Button Grid.Column="2" Text="X" Clicked="OnRemoveAttendeeClicked" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="+ Add Attendee" Clicked="OnAddAttendeeClicked" />
            <Button Text="Save" Clicked="OnSaveClicked" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
